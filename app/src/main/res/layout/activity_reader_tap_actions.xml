<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<com.google.android.material.appbar.MaterialToolbar
		android:id="@id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize" />

	<com.google.android.material.button.MaterialButtonToggleGroup
		android:id="@+id/gesture_mode"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		app:singleSelection="true"
		app:selectionRequired="true"
		app:checkedButton="@id/mode_tap">
		<com.google.android.material.button.MaterialButton
			android:id="@+id/mode_tap"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/tap_action" />
		<com.google.android.material.button.MaterialButton
			android:id="@+id/mode_hold"
			style="?attr/materialButtonOutlinedStyle"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/long_tap_action" />
	</com.google.android.material.button.MaterialButtonToggleGroup>
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="12dp"
			android:orientation="vertical">
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:baselineAligned="false"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textView_top_left"
					style="@style/Widget.Kotatsu.GestureCell"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/textView_top_center"
					style="@style/Widget.Kotatsu.GestureCell"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/textView_top_right"
					style="@style/Widget.Kotatsu.GestureCell"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1" />
			</LinearLayout>
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:baselineAligned="false"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textView_center_left"
					style="@style/Widget.Kotatsu.GestureCell"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/textView_center"
					style="@style/Widget.Kotatsu.GestureCell"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/textView_center_right"
					style="@style/Widget.Kotatsu.GestureCell"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1" />
			</LinearLayout>
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:baselineAligned="false"
				android:orientation="horizontal">
				<TextView
					android:id="@+id/textView_bottom_left"
					style="@style/Widget.Kotatsu.GestureCell"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/textView_bottom_center"
					style="@style/Widget.Kotatsu.GestureCell"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1" />
				<TextView
					android:id="@+id/textView_bottom_right"
					style="@style/Widget.Kotatsu.GestureCell"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
